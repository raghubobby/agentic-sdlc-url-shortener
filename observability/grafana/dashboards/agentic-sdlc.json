{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Workflow completions (5m)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(agentic_audit_events_total{event=\"workflow_completed\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Workflow failures (5m)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(agentic_audit_events_total{event=\"workflow_failed\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Retries (5m)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(agentic_audit_events_total{event=\"node_retry_scheduled\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Compensations (5m)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(agentic_audit_events_total{event=\"compensation_started\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Workflow duration p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,outcome) (rate(agentic_workflow_duration_seconds_bucket[5m])))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node duration p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,node) (rate(agentic_node_duration_seconds_bucket[5m])))",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "URL redirect cache hit ratio",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "expr": "rate(url_redirect_cache_hit_total[5m]) / clamp_min(rate(url_redirect_cache_hit_total[5m]) + rate(url_redirect_cache_miss_total[5m]), 0.000001)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "URL cache / analytics errors",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "expr": "rate(url_redirect_cache_error_total[5m])",
          "legendFormat": "cache errors",
          "refId": "A"
        },
        {
          "expr": "rate(url_analytics_record_failure_total[5m])",
          "legendFormat": "analytics failures",
          "refId": "B"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Workflow success ratio (15m)",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(agentic_audit_events_total{event=\"workflow_completed\"}[15m])) / clamp_min(sum(increase(agentic_audit_events_total{event=~\"workflow_completed|workflow_failed\"}[15m])), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Governance/replan events",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "expr": "rate(agentic_audit_events_total{event=\"replan_completed\"}[5m])",
          "legendFormat": "replans",
          "refId": "A"
        },
        {
          "expr": "rate(agentic_audit_events_total{event=\"policy_denied\"}[5m])",
          "legendFormat": "policy denials",
          "refId": "B"
        },
        {
          "expr": "rate(agentic_audit_events_total{event=\"failure_injected\"}[5m])",
          "legendFormat": "injected failures",
          "refId": "C"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": [
    "agentic",
    "sdlc",
    "assessment"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "title": "Governed Agentic SDLC",
  "uid": "agentic-sdlc"
}
