FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml .
COPY control-plane/pom.xml control-plane/pom.xml
COPY url-shortener/pom.xml url-shortener/pom.xml
RUN mvn -q dependency:go-offline
COPY control-plane control-plane
COPY url-shortener url-shortener
RUN mvn -q -pl url-shortener -am -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /build/url-shortener/target/url-shortener-*.jar app.jar
EXPOSE 8082
ENTRYPOINT ["java","-jar","/app/app.jar"]
